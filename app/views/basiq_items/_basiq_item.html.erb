<%# locals: (basiq_item:) %>

<%= tag.div id: dom_id(basiq_item) do %>
  <details open class="group bg-container p-4 shadow-border-xs rounded-xl">
    <summary class="flex items-center justify-between gap-2 focus-visible:outline-hidden">
      <div class="flex items-center gap-2">
        <%= icon "chevron-right", class: "group-open:transform group-open:rotate-90" %>

        <div class="flex items-center justify-center h-8 w-8 bg-emerald-500/10 rounded-full">
          <% if basiq_item.logo.attached? %>
            <%= image_tag basiq_item.logo, class: "rounded-full h-full w-full", loading: "lazy" %>
          <% else %>
            <div class="flex items-center justify-center">
              <%= tag.p basiq_item.institution_display_name.first.to_s.upcase, class: "text-emerald-600 text-xs font-medium" %>
            </div>
          <% end %>
        </div>

        <div class="pl-1 text-sm">
          <div class="flex items-center gap-2">
            <%= tag.p basiq_item.institution_display_name, class: "font-medium text-primary" %>
            <% if basiq_item.scheduled_for_deletion? %>
              <p class="text-destructive text-sm animate-pulse">Deletion in progress</p>
            <% end %>
          </div>
          <p class="text-xs text-secondary">BASIQ</p>
          <% if basiq_item.syncing? %>
            <div class="text-secondary flex items-center gap-1">
              <%= icon "loader", size: "sm", class: "animate-spin" %>
              <%= tag.span "Syncing..." %>
            </div>
          <% elsif basiq_item.requires_update? %>
            <div class="text-warning flex items-center gap-1">
              <%= icon "alert-triangle", size: "sm", color: "warning" %>
              <%= tag.span "Reconnect" %>
            </div>
          <% else %>
            <p class="text-secondary">
              <% if basiq_item.last_synced_at %>
                Last synced <%= time_ago_in_words(basiq_item.last_synced_at) %> ago
                <% if basiq_item.sync_status_summary %>
                  · <%= basiq_item.sync_status_summary %>
                <% end %>
              <% else %>
                Never synced
              <% end %>
            </p>
          <% end %>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <%= button_to new_connection_basiq_item_path(basiq_item),
                      method: :post,
                      class: "inline-flex items-center gap-1 px-3 py-1.5 text-sm font-medium rounded-lg text-white bg-gray-900 hover:bg-gray-800 transition-colors",
                      data: { turbo: false } do %>
          <%= icon "plus", size: "sm" %>
          Add bank
        <% end %>

        <% if Rails.env.development? %>
          <%= icon(
            "refresh-cw",
            as_button: true,
            href: sync_basiq_item_path(basiq_item)
          ) %>
        <% end %>

        <%= render DS::Menu.new do |menu| %>
          <% menu.with_item(
            variant: "button",
            text: "Delete",
            icon: "trash-2",
            href: basiq_item_path(basiq_item),
            method: :delete,
            confirm: CustomConfirm.for_resource_deletion(basiq_item.institution_display_name, high_severity: true)
          ) %>
        <% end %>
      </div>
    </summary>

    <% unless basiq_item.scheduled_for_deletion? %>
      <div class="space-y-4 mt-4">
        <% if basiq_item.accounts.any? %>
          <%= render "accounts/index/account_groups", accounts: basiq_item.accounts %>
        <% end %>

        <% stats = if defined?(@basiq_sync_stats_map) && @basiq_sync_stats_map
             @basiq_sync_stats_map[basiq_item.id] || {}
           else
             basiq_item.syncs.ordered.first&.sync_stats || {}
           end %>
        <%= render ProviderSyncSummary.new(
          stats: stats,
          provider_item: basiq_item,
          institutions_count: basiq_item.connected_institutions.size
        ) %>

        <% if basiq_item.unlinked_accounts_count > 0 %>
          <div class="p-4 flex flex-col gap-3 items-center justify-center">
            <p class="text-primary font-medium text-sm">Setup needed</p>
            <p class="text-secondary text-sm"><%= pluralize(basiq_item.unlinked_accounts_count, "account") %> imported from BASIQ need to be set up</p>
            <%= render DS::Link.new(
              text: "Set up accounts",
              icon: "settings",
              variant: "primary",
              href: setup_accounts_basiq_item_path(basiq_item),
              frame: :modal
            ) %>
          </div>
        <% elsif basiq_item.accounts.empty? && basiq_item.basiq_accounts.empty? %>
          <div class="p-4 flex flex-col gap-3 items-center justify-center">
            <p class="text-primary font-medium text-sm">No accounts found</p>
            <p class="text-secondary text-sm">No accounts were found from BASIQ. Try syncing again.</p>
          </div>
        <% end %>
      </div>
    <% end %>
  </details>
<% end %>
